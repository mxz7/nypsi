diff --git a/src/util/defineLazyManager.js b/src/util/defineLazyManager.js
new file mode 100644
index 0000000000000000000000000000000000000000..d7d7a946f09f8230704bfe87efafcfb37a6a6370
--- /dev/null
+++ b/src/util/defineLazyManager.js
@@ -0,0 +1,20 @@
+'use strict';
+const getters = new Map();
+function defineLazyManager(owner, name, Manager, dataProperty) {
+  let descriptors = getters.get(Manager);
+  if (!descriptors) {
+    const set = function setManager(value) {
+      Object.defineProperty(this, name, { value, writable: true, configurable: true, enumerable: true });
+    };
+    const get = function getManager() {
+      const manager = new Manager(this, dataProperty ? this[dataProperty] : undefined);
+      if (dataProperty) this[dataProperty] = null;
+      set.call(this, manager);
+      return manager;
+    };
+    descriptors = { get, set, configurable: true, enumerable: true };
+    getters.set(Manager, descriptors);
+  }
+  Object.defineProperty(owner, name, descriptors);
+}
+module.exports = defineLazyManager;
diff --git a/src/util/getFrozenPermissions.js b/src/util/getFrozenPermissions.js
new file mode 100644
index 0000000000000000000000000000000000000000..58346e8028877ba27593823240d30b01437527cc
--- /dev/null
+++ b/src/util/getFrozenPermissions.js
@@ -0,0 +1,23 @@
+'use strict';
+
+const PermissionsBitField = require('./PermissionsBitField');
+
+const permissions = new Map();
+const maxSize = 1_024;
+
+/**
+ * Shares immutable permission bitfields used by cached structures.
+ * @param {bigint} bits The permission bits
+ * @returns {Readonly<PermissionsBitField>}
+ * @private
+ */
+function getFrozenPermissions(bits) {
+  const existing = permissions.get(bits);
+  if (existing) return existing;
+
+  const value = new PermissionsBitField(bits).freeze();
+  if (permissions.size < maxSize) permissions.set(bits, value);
+  return value;
+}
+
+module.exports = getFrozenPermissions;
